# Copy to deploy/deploy.env and edit. deploy/deploy.env is gitignored.
#
# This file holds NO passwords. Deployment authenticates with your SSH key via
# ssh-agent. If you find yourself wanting to add a password here, set up a key
# instead — the previous version of this repo shipped the production root
# password in 223 files, and that is the mistake this layout exists to prevent.

# --- Target host -------------------------------------------------------------
SSH_HOST=mail.example.com
SSH_USER=deploy
SSH_PORT=22

# --- Paths on the server -----------------------------------------------------
APP_ROOT=/opt/mailpanel
RELEASES_ROOT=/opt/mailpanel-releases
KEEP_RELEASES=5

# --- System users / services -------------------------------------------------
WEB_USER=www-data
AGENT_USER=mailpanel-agent
PHP_FPM_SERVICE=php8.3-fpm
